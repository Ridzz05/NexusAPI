APP_ENV=production
HTTP_ADDR=:8080
NEXUS_API_HOST=api.example.com

POSTGRES_USER=nexus
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
POSTGRES_DB=nexus
DATABASE_URL=postgres://nexus:replace-with-a-url-safe-random-password@postgres:5432/nexus?sslmode=disable
REDIS_URL=redis://redis:6379/0
DB_MAX_CONNS=20
DB_MIN_CONNS=4

# The production Compose profile reserves 172.30.0.0/24 for Caddy -> API.
TRUSTED_PROXY_CIDRS=172.30.0.0/24
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=
JWT_AUDIENCE=
CORS_ALLOWED_ORIGINS=https://app.example.com
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=10s
HTTP_MAX_HEADER_BYTES=1048576
SHUTDOWN_TIMEOUT=10s

LOYAL_FITNESS_BASE_URL=
LOYAL_FITNESS_TOKEN=
LOYAL_FITNESS_TIMEOUT=5s
READ_CACHE_TTL=30s
