APP_ENV=development
HTTP_ADDR=:8080

# Start PostgreSQL and Redis with: docker compose up -d postgres redis
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus?sslmode=disable
REDIS_URL=redis://localhost:6379/0
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# Generate a local value with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=
JWT_AUDIENCE=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=10s

# Optional read adapter. Leave empty until the Loyal Fitness source contract is configured.
LOYAL_FITNESS_BASE_URL=
LOYAL_FITNESS_TOKEN=
LOYAL_FITNESS_TIMEOUT=5s
READ_CACHE_TTL=30s
