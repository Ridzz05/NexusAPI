[Unit]
Description=NexusAPI REST API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexus
Group=nexus
WorkingDirectory=/opt/nexus-api
EnvironmentFile=/etc/nexus-api/nexus-api.env
ExecStart=/usr/local/bin/nexus-api
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nexus-api
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
